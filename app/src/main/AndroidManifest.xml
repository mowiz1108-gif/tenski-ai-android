
package com.tenski.ai

import android.Manifest
import android.app.Activity
import android.content.pm.PackageManager
import android.os.Bundle
import android.graphics.*
import android.view.View
import android.view.MotionEvent
import android.animation.ValueAnimator
import android.view.animation.LinearInterpolator
import android.media.AudioRecord
import android.media.AudioFormat
import android.media.MediaRecorder
import android.widget.Toast
import android.content.Context
import kotlin.math.*

class MainActivity : Activity() {

    private lateinit var island: TenskiView
    private var recorder: AudioRecord? = null
    private var recording = false
    private var audioThread: Thread? = null

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        window.statusBarColor = Color.rgb(5, 5, 15)
        window.navigationBarColor = Color.rgb(5, 5, 15)

        island = TenskiView(this) { startListening() }
        setContentView(island)
    }

    private fun startListening() {
        if (recording) {
            stopListening()
            return
        }

        if (checkSelfPermission(Manifest.permission.RECORD_AUDIO)
            != PackageManager.PERMISSION_GRANTED) {
            requestPermissions(
                arrayOf(Manifest.permission.RECORD_AUDIO), 100
            )
            return
        }

        try {
            val sampleRate = 16000
            val bufferSize = AudioRecord.getMinBufferSize(
                sampleRate,
                AudioFormat.CHANNEL_IN_MONO,
                AudioFormat.ENCODING_PCM_16BIT
            )

            if (bufferSize <= 0) {
                Toast.makeText(this, "Microphone unavailable", Toast.LENGTH_SHORT).show()
                return
            }

            recorder = AudioRecord(
                MediaRecorder.AudioSource.MIC,
                sampleRate,
                AudioFormat.CHANNEL_IN_MONO,
                AudioFormat.ENCODING_PCM_16BIT,
                max(bufferSize, 4096)
            )

            recorder?.startRecording()
            recording = true
            island.setMode(1)

            audioThread = Thread {
                val buffer = ShortArray(1024)

                while (recording) {
                    val count = recorder?.read(buffer, 0, buffer.size) ?: 0

                    if (count > 0) {
                        var total = 0.0
                        for (i in 0 until count) {
                            total += buffer[i].toDouble().pow(2)
                        }

                        val rms = sqrt(total / count).toFloat()
                        val level = (rms / 9000f).coerceIn(0f, 1f)

                        runOnUiThread {
                            island.setSoundLevel(level)
                        }
                    }
                }
            }
            audioThread?.start()

            Toast.makeText(this, "Listening...", Toast.LENGTH_SHORT).show()

        } catch (e: Exception) {
            stopListening()
            Toast.makeText(this, "Could not start microphone", Toast.LENGTH_SHORT).show()
        }
    }

    private fun stopListening() {
        recording = false

        try {
            recorder?.stop()
            recorder?.release()
        } catch (_: Exception) {}

        recorder = null
        island.setMode(0)
        island.setSoundLevel(0f)
    }

    override fun onRequestPermissionsResult(
        requestCode: Int,
        permissions: Array<out String>,
        grantResults: IntArray
    ) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults)

        if (requestCode == 100 &&
            grantResults.isNotEmpty() &&
            grantResults[0] == PackageManager.PERMISSION_GRANTED) {
            startListening()
        }
    }

    override fun onDestroy() {
        stopListening()
        super.onDestroy()
    }
}

class TenskiView(
    context: Context,
    private val onIslandTap: () -> Unit
) : View(context) {

    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
    private var phase = 0f
    private var soundLevel = 0f
    private var currentMode = 0

    private val modes = arrayOf("IDLE", "LISTENING")

    private val animator = ValueAnimator.ofFloat(0f, 2f * PI.toFloat())

    init {
        animator.duration = 2400
        animator.repeatCount = ValueAnimator.INFINITE
        animator.interpolator = LinearInterpolator()
        animator.addUpdateListener {
            phase = it.animatedValue as Float
            invalidate()
        }
        animator.start()
    }

    fun setMode(mode: Int) {
        currentMode = mode.coerceIn(0, 1)
        invalidate()
    }

    fun setSoundLevel(level: Float) {
        soundLevel = level.coerceIn(0f, 1f)
        invalidate()
    }

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        canvas.drawColor(Color.rgb(5, 5, 15))

        val density = resources.displayMetrics.density
        val cx = width / 2f
        val top = 12f * density
        val w = min(width * 0.78f, 300f * density)
        val h = 66f * density

        val rect = RectF(cx - w / 2, top, cx + w / 2, top + h)

        val colors = if (currentMode == 1) {
            intArrayOf(Color.CYAN, Color.BLUE, Color.CYAN)
        } else {
            intArrayOf(Color.CYAN, Color.BLUE, Color.MAGENTA)
        }

        paint.style = Paint.Style.STROKE
        paint.strokeWidth = 3f * density
        paint.shader = LinearGradient(
            rect.left, top, rect.right, top + h,
            colors, null, Shader.TileMode.CLAMP
        )
        paint.setShadowLayer(22f * density, 0f, 0f, colors[1])
        canvas.drawRoundRect(rect, h / 2, h / 2, paint)
        paint.clearShadowLayer()

        paint.style = Paint.Style.FILL
        paint.shader = LinearGradient(
            rect.left, top, rect.right, top + h,
            Color.rgb(15, 18, 38),
            Color.rgb(28, 12, 40),
            Shader.TileMode.CLAMP
        )
        canvas.drawRoundRect(rect, h / 2, h / 2, paint)
        paint.shader = null

        val centerY = top + h / 2
        val startX = cx - 48f * density
        val gap = 6f * density

        for (i in 0 until 17) {
            val wave = abs(sin(phase + i * 0.48f))
            val height = (
                5f + wave * 10f + soundLevel * 24f
            ) * density

            val x = startX + i * gap
            paint.color = colors[i % colors.size]

            canvas.drawRoundRect(
                x, centerY - height / 2,
                x + 3f * density, centerY + height / 2,
                4f * density, 4f * density, paint
            )
        }

        paint.color = Color.WHITE
        paint.textSize = 13f * density
        paint.typeface = Typeface.create(
            "sans-serif-medium", Typeface.NORMAL
        )
        paint.textAlign = Paint.Align.CENTER

        canvas.drawText("TENSKI AI", cx, top + h + 38f * density, paint)

        paint.color = Color.LTGRAY
        paint.textSize = 11f * density
        canvas.drawText(
            modes[currentMode], cx, top + h + 58f * density, paint
        )
    }

    override fun onTouchEvent(event: MotionEvent): Boolean {
        if (event.action == MotionEvent.ACTION_UP) {
            onIslandTap()
            performClick()
            return true
        }
        return true
    }

    override fun performClick(): Boolean {
        super.performClick()
        return true
    }

    override fun onDetachedFromWindow() {
        animator.cancel()
        super.onDetachedFromWindow()
    }
}
